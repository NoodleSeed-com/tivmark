generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MEMBER
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
}

enum TimeOffDuration {
  FULL_DAY
  HALF_DAY
}

enum HalfDayPeriod {
  MORNING
  AFTERNOON
}

enum EquipmentCategory {
  LAPTOP
  MONITOR
  PHONE
  PERIPHERAL
  FURNITURE
  OTHER
}

enum EquipmentStatus {
  PENDING
  APPROVED
  DECLINED
  FULFILLED
  CANCELED
}

enum NewHireLaunchStatus {
  READY
  ACTIVE
}

enum NewHireEquipmentPackage {
  STANDARD
  DESIGN
  ENGINEERING
  NONE
}

enum ServiceAudience {
  PUBLIC
  CUSTOMER
  EMPLOYEE
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_REQUESTER
  RESOLVED
  CANCELED
}

enum ServiceRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestSource {
  WEB
  ASSISTANT
  MCP
}

enum ServiceRequestEventType {
  CREATED
  STATUS_CHANGED
  COMMENT
  ASSIGNED
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  invalid_login_attempts Int       @default(0)
  lockedAt               DateTime?

  teamMembers               TeamMember[]
  accounts                  Account[]
  sessions                  Session[]
  invitations               Invitation[]
  createdApiKeys            ApiKey[]              @relation("ApiKeyCreator")
  timeOffRequests           TimeOffRequest[]      @relation("TimeOffRequester")
  reviewedTimeOffRequests   TimeOffRequest[]      @relation("TimeOffReviewer")
  equipmentRequests         EquipmentRequest[]    @relation("EquipmentRequester")
  reviewedEquipmentRequests EquipmentRequest[]    @relation("EquipmentReviewer")
  newHireLaunches           NewHireLaunch[]       @relation("NewHireLaunchCreator")
  serviceRequests           ServiceRequest[]      @relation("ServiceRequester")
  assignedServiceRequests   ServiceRequest[]      @relation("ServiceAssignee")
  serviceRequestEvents      ServiceRequestEvent[]
}

model Team {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  domain                String?               @unique
  defaultRole           Role                  @default(MEMBER)
  businessSizeBand      String?
  timeZone              String?
  onboardingGoal        String?
  onboardingCompletedAt DateTime?
  billingId             String?
  billingProvider       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  members               TeamMember[]
  invitations           Invitation[]
  apiKeys               ApiKey[]
  timeOffPolicies       TimeOffPolicy[]
  timeOffRequests       TimeOffRequest[]
  equipmentRequests     EquipmentRequest[]
  newHireLaunches       NewHireLaunch[]
  actionServices        ActionService[]
  serviceRequests       ServiceRequest[]
  oauthClients          OAuthClient[]
  enterpriseOnboarding  EnterpriseOnboarding?

  @@index([billingId])
}

model EnterpriseOnboarding {
  id        String                      @id @default(uuid())
  teamId    String                      @unique
  version   Int                         @default(1)
  state     Json
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  team      Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  research  EnterpriseResearch[]
  events    EnterpriseOnboardingEvent[]
}

model EnterpriseResearch {
  id          String               @id @default(uuid())
  journeyId   String
  status      String               @default("QUEUED")
  attempts    Int                  @default(0)
  input       Json
  result      Json?
  acceptedIds String[]             @default([])
  model       String
  error       String?
  createdAt   DateTime             @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  journey     EnterpriseOnboarding @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
  @@index([status, createdAt])
}

model EnterpriseOnboardingEvent {
  id        String               @id @default(uuid())
  journeyId String
  actor     String
  actorId   String?
  message   String
  createdAt DateTime             @default(now())
  journey   EnterpriseOnboarding @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
}

model TimeOffPolicy {
  id                      String      @id @default(uuid())
  teamId                  String
  type                    TimeOffType
  annualAllowanceHalfDays Int?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, type])
  @@index([teamId])
}

model TimeOffRequest {
  id                String          @id @default(uuid())
  teamId            String
  requesterId       String
  reviewerId        String?
  type              TimeOffType
  status            TimeOffStatus   @default(PENDING)
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  duration          TimeOffDuration @default(FULL_DAY)
  halfDayPeriod     HalfDayPeriod?
  requestedHalfDays Int
  reason            String?         @db.VarChar(500)
  reviewNote        String?         @db.VarChar(500)
  reviewedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester User  @relation("TimeOffRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("TimeOffReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([teamId, startDate])
  @@index([teamId, status])
  @@index([teamId, requesterId])
}

model EquipmentRequest {
  id            String            @id @default(uuid())
  teamId        String
  requesterId   String
  reviewerId    String?
  category      EquipmentCategory
  item          String            @db.VarChar(200)
  quantity      Int               @default(1)
  justification String?           @db.VarChar(500)
  status        EquipmentStatus   @default(PENDING)
  reviewNote    String?           @db.VarChar(500)
  reviewedAt    DateTime?
  fulfilledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester     User           @relation("EquipmentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer      User?          @relation("EquipmentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  newHireLaunch NewHireLaunch?

  @@index([teamId, status])
  @@index([teamId, requesterId])
  @@index([teamId, createdAt])
}

model ActionService {
  id               String          @id @default(uuid())
  teamId           String
  slug             String          @db.VarChar(80)
  name             String          @db.VarChar(100)
  description      String          @db.VarChar(500)
  audience         ServiceAudience @default(CUSTOMER)
  active           Boolean         @default(true)
  slaHours         Int?
  requiresApproval Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@unique([teamId, slug])
  @@index([teamId, active])
}

model ServiceRequest {
  id          String                 @id @default(uuid())
  teamId      String
  serviceId   String
  requesterId String
  assigneeId  String?
  subject     String                 @db.VarChar(160)
  description String                 @db.VarChar(2000)
  priority    ServiceRequestPriority @default(NORMAL)
  status      ServiceRequestStatus   @default(OPEN)
  source      ServiceRequestSource   @default(WEB)
  resolution  String?                @db.VarChar(1000)
  resolvedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  team      Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  service   ActionService         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  requester User                  @relation("ServiceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?                 @relation("ServiceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events    ServiceRequestEvent[]

  @@index([teamId, status, createdAt])
  @@index([teamId, requesterId, createdAt])
  @@index([serviceId])
}

model ServiceRequestEvent {
  id        String                  @id @default(uuid())
  requestId String
  actorId   String?
  type      ServiceRequestEventType
  message   String                  @db.VarChar(1000)
  createdAt DateTime                @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid())
  teamId         String
  email          String?
  role           Role     @default(MEMBER)
  token          String   @unique
  expires        DateTime
  invitedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  sentViaEmail   Boolean  @default(true)
  allowedDomains String[] @default([])

  user          User           @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  newHireLaunch NewHireLaunch?

  @@unique([teamId, email])
  @@index([email])
}

model NewHireLaunch {
  id                 String                  @id @default(uuid())
  teamId             String
  createdById        String?
  invitationId       String?                 @unique
  equipmentRequestId String?                 @unique
  employeeName       String                  @db.VarChar(120)
  employeeEmail      String                  @db.VarChar(320)
  jobTitle           String                  @db.VarChar(120)
  startDate          DateTime                @db.Date
  workLocation       String                  @db.VarChar(120)
  timeZone           String                  @db.VarChar(100)
  role               Role                    @default(MEMBER)
  equipmentPackage   NewHireEquipmentPackage @default(STANDARD)
  status             NewHireLaunchStatus     @default(READY)
  activatedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("NewHireLaunchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  invitation       Invitation?       @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  equipmentRequest EquipmentRequest? @relation(fields: [equipmentRequestId], references: [id], onDelete: SetNull)

  @@unique([teamId, employeeEmail])
  @@index([teamId, status])
  @@index([teamId, startDate])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  teamId      String
  hashedKey   String    @unique
  prefix      String?
  scopes      String[]  @default([])
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([createdById])
}

model OAuthClient {
  id             String   @id @default(uuid())
  clientId       String   @unique
  name           String
  // Nullable: self-registered (RFC 7591 DCR) clients are not owned by a team. Team-owned clients
  // created via the admin API still set teamId.
  teamId         String?
  redirectUris   String[]
  allowedOrigins String[]
  scopes         String[]
  trusted        Boolean  @default(false)
  // SHA-256 hash of the client secret for CONFIDENTIAL DCR clients (token_endpoint_auth_method
  // client_secret_basic/post, e.g. Gemini). Null for public PKCE clients (Claude/ChatGPT).
  clientSecret   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model OAuthPayload {
  id        String    @id
  model     String
  payload   Json
  grantId   String?
  userCode  String?
  uid       String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([model, id])
  @@index([grantId])
  @@index([userCode])
  @@index([uid])
  @@index([expiresAt])
}

model ApiRateLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model ApiIdempotencyRecord {
  id           String   @id
  principalId  String
  method       String
  path         String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([principalId])
  @@index([expiresAt])
}

model Subscription {
  id         String    @id
  customerId String
  priceId    String
  active     Boolean   @default(false)
  startDate  DateTime
  endDate    DateTime
  cancelAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([customerId])
}

model Service {
  id          String   @id @default(uuid())
  description String
  features    String[]
  image       String
  name        String
  created     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Price       Price[]
}

model Price {
  id            String   @id @default(uuid())
  billingScheme String
  currency      String
  serviceId     String
  amount        Int?
  metadata      Json
  type          String
  created       DateTime

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model jackson_store {
  key        String    @id(map: "_jackson_store_key") @db.VarChar(1500)
  value      String
  iv         String?   @db.VarChar(64)
  tag        String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  modifiedAt DateTime? @db.Timestamp(6)
  namespace  String?   @db.VarChar(256)

  jackson_index jackson_index[]

  @@index([namespace], map: "_jackson_store_namespace")
  @@ignore
}

model jackson_index {
  id       Int    @id(map: "_jackson_index_id") @default(autoincrement())
  key      String @db.VarChar(1500)
  storeKey String @db.VarChar(1500)

  store jackson_store @relation(fields: [storeKey], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@index([key], map: "_jackson_index_key")
  @@index([key, storeKey], map: "_jackson_index_key_store")
  @@ignore
}

model jackson_ttl {
  key       String @id(map: "jackson_ttl_key") @db.VarChar(1500)
  expiresAt BigInt

  @@index([expiresAt], map: "_jackson_ttl_expires_at")
  @@ignore
}
