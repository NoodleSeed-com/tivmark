{
  "name": "tivmark",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "check-types:web": "npm run check-types --workspace apps/web",
    "lint:web": "npm run check-lint --workspace apps/web",
    "format:web": "npm run format --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "dev:assistant": "npm run dev --prefix apps/assistant",
    "validate:assistant": "npm run validate --prefix apps/assistant",
    "test:assistant": "npm run test --prefix apps/assistant",
    "deploy:assistant": "npm run deploy --prefix apps/assistant"
  },
  "engines": {
    "node": ">=22"
  }
}